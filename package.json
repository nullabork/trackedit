{
  "name": "trackedit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web-based Trackmania 2020 map editor",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:bridge": "tsc --noEmit --strict --module esnext --moduleResolution bundler --target es2022 --skipLibCheck tools/liveBridge.ts",
    "test": "vitest run",
    "roundtrip": "tsx tools/roundtrip_check.ts",
    "variantcheck": "tsx tools/variant_check.ts",
    "capcheck": "python tools/cap_check.py",
    "cliptruth": "tsx tools/clip_truth.ts",
    "fieldaudit": "tsx tools/field_audit.ts",
    "capfit": "python tools/cap_fit_check.py",
    "clipgeom": "python tools/clip_geometry_check.py"
  },
  "dependencies": {
    "three": "^0.168.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/three": "^0.168.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
