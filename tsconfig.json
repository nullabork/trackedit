{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@input/*": ["src/input/*"],
      "@io/*": ["src/io/*"],
      "@render/*": ["src/render/*"],
      "@tools/*": ["src/tools/*"],
      "@plugins/*": ["src/plugins/*"],
      "@ui/*": ["src/ui/*"]
    }
  },
  "include": ["src"]
}
